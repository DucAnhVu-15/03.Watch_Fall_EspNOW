menu "Watch Fall - Master"

    config WF_MASTER_AUTOSTART
        bool "Tự bắt đầu ghi khi khởi động"
        default y

    config WF_BUTTON_GPIO
        int "GPIO nút START/STOP"
        default 0
        help
            XIAO ESP32-S3: nút BOOT = GPIO0 (tích cực mức thấp).

    config WF_MASTER_DUMP_CSV
        bool "In dữ liệu CSV ra console"
        default n
        help
            In từng mẫu ra log với tiền tố "S," (Slave) và "M," (Master).
            Tạm thay cho việc ghi LittleFS để kiểm tra dữ liệu trên PC.

endmenu
